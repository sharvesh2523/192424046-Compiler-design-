#include <stdio.h>
#include <ctype.h>
#include <string.h>

int main(){
    char s[500],w[50]; int i=0,j;
    printf("Enter C program:\n");
    while(fgets(s,500,stdin)){
        for(i=0;s[i];i++){
            if(s[i]=='/'&&s[i+1]=='/') break;
            if(isspace(s[i])) continue;

            if(isalpha(s[i])||s[i]=='_'){
                j=0; while(isalnum(s[i])||s[i]=='_') w[j++]=s[i++];
                w[j]='\0'; i--;
                printf("Identifier: %s\n",w);
            }
            else if(isdigit(s[i])){
                j=0; while(isdigit(s[i])) w[j++]=s[i++];
                w[j]='\0'; i--;
                printf("Constant: %s\n",w);
            }
            else if(strchr("+-*/%=<>!&|",s[i]))
                printf("Operator: %c\n",s[i]);
        }
    }
    return 0;
}
