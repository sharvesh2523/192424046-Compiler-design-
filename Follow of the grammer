#include <stdio.h>
#include <ctype.h>
#include <string.h>

char p[20][30],first[26][20],follow[26][20];
int n;

void add(char a[],char c)
{
    int i;
    for(i=0;a[i];i++) if(a[i]==c) return;
    a[i]=c; a[i+1]='\0';
}

int main()
{
    int i,j,k,x,change,nullable;
    char A,c;

    printf("Enter number of productions: ");
    scanf("%d",&n);

    printf("Enter productions (use # for epsilon):\n");
    for(i=0;i<n;i++) scanf("%s",p[i]);

    /* FIRST */
    do{
        change=0;
        for(i=0;i<n;i++){
            x=p[i][0]-'A';
            nullable=1;
            for(j=3;p[i][j];j++){
                c=p[i][j];
                if(c=='#') break;

                if(!isupper(c)){
                    if(!strchr(first[x],c)){ add(first[x],c); change=1; }
                    nullable=0; break;
                }

                k=c-'A';
                for(int z=0;first[k][z];z++)
                    if(first[k][z]!='#' && !strchr(first[x],first[k][z]))
                    { add(first[x],first[k][z]); change=1; }

                if(!strchr(first[k],'#')){
                    nullable=0; break;
                }
            }
            if(nullable && !strchr(first[x],'#'))
            { add(first[x],'#'); change=1; }
        }
    }while(change);

    /* FOLLOW of start symbol */
    add(follow[p[0][0]-'A'],'$');

    /* FOLLOW */
    do{
        change=0;
        for(i=0;i<n;i++){
            A=p[i][0];
            for(j=3;p[i][j];j++){
                c=p[i][j];
                if(!isupper(c)) continue;

                x=c-'A';
                nullable=1;

                for(k=j+1;p[i][k];k++){
                    char d=p[i][k];

                    if(!isupper(d)){
                        if(!strchr(follow[x],d))
                        { add(follow[x],d); change=1; }
                        nullable=0; break;
                    }

                    for(int z=0;first[d-'A'][z];z++)
                        if(first[d-'A'][z]!='#' &&
                           !strchr(follow[x],first[d-'A'][z]))
                        { add(follow[x],first[d-'A'][z]); change=1; }

                    if(!strchr(first[d-'A'],'#')){
                        nullable=0; break;
                    }
                }

                if(nullable)
                    for(int z=0;follow[A-'A'][z];z++)
                        if(!strchr(follow[x],follow[A-'A'][z]))
                        { add(follow[x],follow[A-'A'][z]); change=1; }
            }
        }
    }while(change);

    printf("\nFOLLOW:\n");
    for(i=0;i<n;i++){
        x=p[i][0]-'A';
        if(i && p[i-1][0]==p[i][0]) continue;
        printf("FOLLOW(%c) = { ",p[i][0]);
        for(j=0;follow[x][j];j++) printf("%c ",follow[x][j]);
        printf("}\n");
    }

    return 0;
}
