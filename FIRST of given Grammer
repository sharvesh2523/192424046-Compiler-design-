#include <stdio.h>
#include <string.h>
#include <ctype.h>

char p[20][30], f[26][20];
int n;

void add(int x,char c)
{
    int i;
    for(i=0;f[x][i];i++)
        if(f[x][i]==c) return;
    f[x][i]=c;
}

void first(int x)
{
    int i,j,k,e;
    char c;

    for(i=0;i<n;i++)
        if(p[i][0]-'A'==x)
        {
            e=1;
            for(j=3;p[i][j];j++)
            {
                c=p[i][j];

                if(c=='#'){ add(x,'#'); break; }

                if(!isupper(c)){ add(x,c); e=0; break; }

                k=c-'A';
                first(k);

                for(int z=0;f[k][z];z++)
                    if(f[k][z]!='#') add(x,f[k][z]);

                e=0;
                for(int z=0;f[k][z];z++)
                    if(f[k][z]=='#') e=1;

                if(!e) break;
            }
            if(e) add(x,'#');
        }
}

int main()
{
    int i,j;
    printf("Enter number of productions: ");
    scanf("%d",&n);

    printf("Enter productions (use # for epsilon):\n");
    for(i=0;i<n;i++) scanf("%s",p[i]);

    for(i=0;i<n;i++) first(p[i][0]-'A');

    printf("\nFIRST:\n");
    for(i=0;i<n;i++)
    {
        int x=p[i][0]-'A';
        if(i && p[i-1][0]==p[i][0]) continue;

        printf("FIRST(%c) = { ",p[i][0]);
        for(j=0;f[x][j];j++) printf("%c ",f[x][j]);
        printf("}\n");
    }
    return 0;
}
